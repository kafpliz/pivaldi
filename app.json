{
  "expo": {
    "name": "Pivaldi - Фантастический ресторан",
    "slug": "pivaldi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pivaldi",
    "newArchEnabled": true,
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pivaldi.kafpliz",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.pivaldi.kafpliz",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#B09D7D",
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "expo-video",
      "expo-font",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "icon": "./assets/images/push_icon.png"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "73c431d8-eee8-4cb0-bf5a-1a1187aa8c7a"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/73c431d8-eee8-4cb0-bf5a-1a1187aa8c7a"
    }
  }
}
